rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // CHANGE THIS EMAIL to your admin email (same as ADMIN_EMAIL in firebase-config.js)
    function isAdmin() { return signedIn() && request.auth.token.email == "you@example.com"; }

    // Questions + correct answers: admin only (players can never read them)
    match /questions/{id} { allow read, write: if isAdmin(); }

    // Game state: everyone signed in can read, only admin (host) writes
    match /games/{code} { allow read: if signedIn(); allow write: if isAdmin(); }

    // Players: anyone signed in can read; each player writes only their own doc
    match /players/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }
  }
}
